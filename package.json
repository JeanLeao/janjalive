{
  "name": "screen-room-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @screen-room/web dev",
    "dev:signaling": "pnpm --filter @screen-room/signaling dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive --filter \"./packages/*\" --filter \"./apps/*\" test",
    "typecheck": "pnpm --recursive typecheck",
    "start:web": "pnpm --filter @screen-room/web start",
    "start:signaling": "pnpm --filter @screen-room/signaling start",
    "preview:web": "pnpm --filter @screen-room/web preview"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.2",
    "ws": "^8.18.0"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
